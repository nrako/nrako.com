# No page is shown in a frame, on this site or another. A snippet's page runs
# the code typed in its fields: framed by another site, a visitor could be led
# to drag text into them. `frame-ancestors` is the rule; X-Frame-Options says
# the same to what does not read it.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# The feeds are prerendered to files without an extension, so Cloudflare cannot
# infer their type and the Content-Type set in src/pages/feed/[type].ts is lost
# at build time. Keep these values in sync with that file.
/feed/atom
  Content-Type: application/atom+xml; charset=utf-8

/feed/rss
  Content-Type: application/rss+xml; charset=utf-8

/feed/json
  Content-Type: application/json; charset=utf-8
