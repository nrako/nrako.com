{
  "name": "nrako-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "oxlint --deny-warnings && eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "POSTS_DIR=tests/fixtures/posts playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "pnpm run build && wrangler deploy && wrangler deploy --config workers/www-redirect/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/preact": "^6.1.5",
    "@atproto/api": "^0.13.19",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fustat": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/caveat-brush": "^5.3.0",
    "@shikijs/rehype": "^4.1.0",
    "@shikijs/transformers": "^4.1.0",
    "astro": "^7.4.11",
    "citation-js-utils": "^1.2.11",
    "feed": "^4.2.2",
    "hastscript": "^9.0.1",
    "katex": "^0.16.47",
    "linkedom": "^0.18.12",
    "livecodes": "^0.14.1",
    "myst-common": "^1.11.0",
    "myst-frontmatter": "^1.7.5",
    "myst-parser": "^1.0.22",
    "myst-to-html": "^1.0.22",
    "myst-transforms": "^1.2.1",
    "preact": "^10.28.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "shiki": "^4.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
