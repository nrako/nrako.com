{
  "name": "nrako-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/preact": "^4.1.3",
    "@atproto/api": "^0.13.19",
    "@shikijs/rehype": "^3.20.0",
    "@shikijs/transformers": "^3.20.0",
    "astro": "^5.16.4",
    "feed": "^4.2.2",
    "hastscript": "^9.0.1",
    "linkedom": "^0.18.12",
    "myst-frontmatter": "^1.7.5",
    "myst-parser": "^1.0.22",
    "myst-to-html": "^1.0.22",
    "myst-transforms": "^1.2.1",
    "preact": "^10.28.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "shiki": "^1.24.4",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.5.0",
    "playwright": "^1.49.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5",
    "typescript-eslint": "^8.49.0",
    "wrangler": "^4.54.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
