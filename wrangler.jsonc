{
  // Wrangler configuration for Cloudflare Workers.
  // The Worker entry is provided by @astrojs/cloudflare; `astro build` emits
  // the deployable configuration that `wrangler deploy` picks up.
  // https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "nrako-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Enable workers.dev subdomain for preview URLs
  "workers_dev": true,
  // Static assets (prerendered HTML, JS, CSS, images) emitted by Astro.
  // Requests that match no asset fall through to the Worker (SSR routes).
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Custom domains (Cloudflare handles DNS and SSL automatically)
  "routes": [
    {
      "pattern": "nrako.com",
      "custom_domain": true,
      "zone_name": "nrako.com",
    },
    {
      "pattern": "www.nrako.com",
      "custom_domain": true,
      "zone_name": "nrako.com",
    },
  ],
}
