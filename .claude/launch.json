      "port": 4323
    },
    {
      "name": "astro-dev-samples",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "POSTS_DIR=samples/posts",
        "pnpm",
        "run",
        "dev",
        "--port",
        "4324",
        "--ignore-lock",
        "--host",
        "0.0.0.0"
      ],
      "port": 4324
