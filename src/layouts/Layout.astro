---
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { readingSettings } from '@/lib/reading'
import '@/styles/global.css'
import '@fontsource-variable/fustat/wght.css'
import '@fontsource-variable/source-sans-3/wght.css'
import '@fontsource-variable/source-code-pro/wght.css'
// The reading faces: declared on every page, fetched only once chosen
import '@fontsource-variable/source-serif-4/opsz.css'
import '@fontsource-variable/source-serif-4/opsz-italic.css'
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css'
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css'
// Every page sets text in Fustat and a heading or the name in Source Sans 3:
// their Latin files are fetched at once, not after the stylesheet
import textLatin from '@fontsource-variable/fustat/files/fustat-latin-wght-normal.woff2?url'
import headingLatin from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  /** The page alone, without the site's header and footer */
  bare?: boolean
}

const {
  title = 'nrako.com',
  description = "nrako's personal website",
  bare = false,
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* `viewport-fit=cover`: the page reaches the edges of a screen with a
         notch or a home indicator, and keeps clear of them itself (`body` and
         `.post-contents` in `global.css`) */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="preload"
      href={textLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={headingLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Immediately detect theme before render to prevent flash
      ;(function () {
        const userTheme = sessionStorage.getItem('theme')
        if (userTheme === 'dark' || userTheme === 'light') {
          document.documentElement.classList.add(userTheme)
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
    <script is:inline define:vars={{ readingSettings }}>
      // The reader's typeface and text size, before render (`lib/reading.ts`)
      for (const setting of Object.values(readingSettings)) {
        let value = null
        try {
          value = localStorage.getItem(setting.storageKey)
        } catch {
          // Storage unavailable: the defaults apply
        }
        if (value !== setting.default && setting.values.includes(value)) {
          document.documentElement.setAttribute(setting.attribute, value)
        }
      }
    </script>
    <slot name="head" />
  </head>
  <body class="font-sans">
    {!bare && <SiteHeader />}
    <main class="container mx-auto min-h-screen px-4 md:px-12 mt-20">
      <slot />
    </main>
    {!bare && <SiteFooter />}
  </body>
</html>
