---
import AboutLink from '@/components/AboutLink.astro'
import ThemeToggle from '@/components/preact/theme-toggle'
import TbGitBranch from '@/components/icons/TbGitBranch'
import TbAt from '@/components/icons/TbAt'
import TbRss from '@/components/icons/TbRss'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = 'nrako.com', description = "nrako's personal website" } =
  Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      // Immediately detect theme before render to prevent flash
      ;(function () {
        const userTheme = sessionStorage.getItem('theme')
        if (userTheme === 'dark' || userTheme === 'light') {
          document.documentElement.classList.add(userTheme)
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
    <script is:inline src="/freshblog.js" defer type="module"></script>
    <slot name="head" />
  </head>
  <body class="bg-white dark:bg-black text-black dark:text-white font-sans">
    <header class="site-header container mx-auto pt-8 px-4 md:px-12">
      <div class="site-header-row gap-3 sm:gap-4">
        <nav class="gap-3 sm:gap-4 [&>a:hover]:text-red-600">
          <a href="/" aria-label="Home Base" title="Home Base">
            {
              /* The view box is the outline of the stroke: the shape's edges are the icon's */
            }
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0.7 0.7 22.6 22.6"
              class="home-plate"
              stroke-width="2.6"
              stroke="currentColor"
            >
              <path
                d="M 2,2 L 22,2 L 22,12 L 12,22 L 2,12 Z"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/posts" aria-label="Blog" title="Posts"> Posts </a>
          {
            /* The homepage plays its introduction when this anchor is reached */
          }
          <AboutLink />
          <a
            href="https://bsky.app/profile/nrako.com"
            aria-label="Social"
            title="Follow me and at-me on Bluesky"
            class="ml-auto"
          >
            <TbAt />
          </a>
          <a
            href="https://github.com/nrako"
            title="Collaborate with me on code"
            aria-label="Code"
          >
            <TbGitBranch />
          </a>
        </nav>
        <ThemeToggle client:load />
      </div>
    </header>
    <main class="container mx-auto min-h-screen px-4 md:px-12 mt-20">
      <slot />
    </main>
    <footer class="text-sm container mx-auto my-4 px-4 md:px-12">
      <div class="mx-auto flex max-w-(--column) justify-between">
        <div class="freshBlog-footer">
          <TbRss />
          <ul class="feed-links">
            <li>
              <a href="/feed/atom" title="Atom 1.0">Atom</a>
            </li>
            <li>
              <a href="/feed/json" title="JSON Feed 1.0">JSON</a>
            </li>
            <li>
              <a href="/feed/rss" title="RSS 2.0">RSS</a>
            </li>
          </ul>
        </div>
        <a
          class="hover:underline decoration-red-600 underline-offset-2 decoration-2"
          href="https://github.com/nrako/nrako.com"
        >
          Source
        </a>
      </div>
    </footer>
  </body>
</html>
