---
import SnippetPage from '@/components/SnippetPage.astro'
import { getPosts, defaultOptions as options } from '@/lib/blogData'
import { postPath, snippetLinks } from '@/lib/permalinks'
import type { PostSnippet } from '@/lib/snippets'
import type { CommitInfo } from '@/lib/githubVersioning'

interface Props {
  snippet: PostSnippet
  post: { slug: string; title: string; versions?: CommitInfo[] }
}

// One page per snippet that has a label, under its post: a label only has to
// be unique within its post.
export async function getStaticPaths() {
  const posts = await getPosts(options)

  return posts.flatMap((post) =>
    post.snippets.map((snippet) => ({
      params: { slug: post.slug, label: snippet.label },
      props: {
        snippet,
        post: {
          slug: post.slug,
          title: post.frontmatter.title ?? post.slug,
          versions: post.versions,
        },
      },
    })),
  )
}

const { snippet, post } = Astro.props
---

<SnippetPage
  snippet={snippet}
  title={post.title}
  postAddress={postPath(post.slug)}
  links={snippetLinks({
    site: Astro.site!,
    slug: post.slug,
    versions: post.versions,
    label: snippet.label,
    inPost: true,
  })}
/>
