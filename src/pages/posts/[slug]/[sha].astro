---
import Layout from '@/layouts/Layout.astro'
import Time from '@/components/Time.astro'
import ReadTime from '@/components/ReadTime.astro'
import DialogMessages from '@/components/DialogMessages.astro'
import Authors from '@/components/Authors.astro'
import PostVersions from '@/components/PostVersions.astro'
import { defaultOptions as options, getPosts } from '@/lib/blogData'
import { getPostAtVersion, type CommitInfo } from '@/lib/githubVersioning'

interface Props {
  versions: CommitInfo[]
}

// One static page per committed version of every post. The versions come from
// the GitHub commit history, so a build without GITHUB_TOKEN generates none.
export async function getStaticPaths() {
  const posts = await getPosts(options)

  return posts.flatMap((post) =>
    (post.versions ?? [])
      .filter((version) => version.sha !== 'draft')
      .map((version) => ({
        params: { slug: post.slug, sha: version.shortSha },
        props: { versions: post.versions ?? [] },
      })),
  )
}

const { slug, sha } = Astro.params
const { versions } = Astro.props

// The latest version is the post itself
if (sha === versions[0]?.shortSha) {
  return Astro.redirect(`/posts/${slug}`)
}

const post = await getPostAtVersion(slug, sha, options)

// The version is listed in the commit history, so failing to load it is a
// build error rather than a page to publish.
if (!post) {
  throw new Error(`Could not load version ${sha} of post "${slug}" from GitHub`)
}

post.versions = versions

const displayMessages = import.meta.env.DEV

// Log messages in development
if (displayMessages) {
  post.messages.errors?.forEach((error) => console.error(post.slug, error))
  post.messages.warnings?.forEach((warning) => console.warn(post.slug, warning))
}
---

<Layout title={`${post.frontmatter.title} (${sha}) - ${options.title}`}>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
    />
  </Fragment>

  {displayMessages && <DialogMessages messages={post.messages} />}

  <article
    class="freshBlog-post prose prose-md md:prose-lg mx-auto dark:prose-invert"
  >
    <header>
      <h1>{post.frontmatter.title}</h1>
      {
        post.frontmatter.subtitle && (
          <p class="freshBlog-post-subtitle">{post.frontmatter.subtitle}</p>
        )
      }
      <div class="freshBlog-post-meta" aria-label="Post Metadata">
        {
          options.showAuthors !== 'never' && post.frontmatter.authors && (
            <Authors
              authors={post.frontmatter.authors}
              affiliations={post.frontmatter.affiliations}
              showLinks
            />
          )
        }
        {
          post.frontmatter.date && (
            <Time date={post.frontmatter.date} language={options.language} />
          )
        }
        {
          post.versions && post.versions.length > 1 && (
            <PostVersions slug={post.slug} versions={post.versions} />
          )
        }
        <ReadTime value={post.readingTimeMinutes} />
      </div>
      <dialog
        role="alertdialog"
        open
        class="freshBlog-dialogMessages not-prose"
      >
        You are looking at version{' '}
        <a
          href={`https://github.com/${options.versioning?.repoOwner}/${options.versioning?.repoName}/commit/${sha}`}
        >
          {sha}
        </a>. Click <a href={`/posts/${post.slug}`}>here</a> to go back to the latest
        version.
      </dialog>
    </header>
    <div
      class="freshBlog-post-content"
      data-light-theme="light"
      data-dark-theme="dark"
      set:html={post.content}
    />
  </article>
</Layout>
