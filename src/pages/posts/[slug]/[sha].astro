---
import katexStyles from 'katex/dist/katex.min.css?url'
import Layout from '@/layouts/Layout.astro'
import DialogMessages from '@/components/DialogMessages.astro'
import PostHeader from '@/components/PostHeader.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import PostLinks from '@/components/PostLinks.astro'
import { defaultOptions as options, getPosts } from '@/lib/blogData'
import { getPostAtVersion, type CommitInfo } from '@/lib/githubVersioning'
import { latestVersion, postLinks, postPath } from '@/lib/permalinks'

interface Props {
  versions: CommitInfo[]
}

// One static page per committed version of every post. The versions come from
// the GitHub commit history, so a build without GITHUB_TOKEN generates none.
export async function getStaticPaths() {
  const posts = await getPosts(options)

  return posts.flatMap((post) =>
    (post.versions ?? [])
      .filter((version) => version.sha !== 'draft')
      .map((version) => ({
        params: { slug: post.slug, sha: version.shortSha },
        props: { versions: post.versions ?? [] },
      })),
  )
}

const { slug, sha } = Astro.params
const { versions } = Astro.props

// The latest version is a page like the others, not a redirect to the post:
// a text fragment (`#:~:text=`) does not survive a redirect.
const isLatest = sha === latestVersion(versions)?.shortSha
const links = postLinks({ site: Astro.site!, slug, versions, shortSha: sha })

const post = await getPostAtVersion(slug, sha, options)

// The version is listed in the commit history, so failing to load it is a
// build error rather than a page to publish.
if (!post) {
  throw new Error(`Could not load version ${sha} of post "${slug}" from GitHub`)
}

post.versions = versions

const displayMessages = import.meta.env.DEV

// Log messages in development
if (displayMessages) {
  post.messages.errors?.forEach((error) => console.error(post.slug, error))
  post.messages.warnings?.forEach((warning) => console.warn(post.slug, warning))
}
---

<Layout title={`${post.frontmatter.title} (${sha}) - ${options.title}`}>
  <PostLinks links={links} slot="head" />
  {/* Searches lead to the post: a version is reached by its permalink */}
  <meta name="robots" content="noindex" slot="head" />
  {
    /* Served from the site, and only to a post that has math to set */
    post.content.includes('class="katex') && (
      <link rel="stylesheet" href={katexStyles} slot="head" />
    )
  }

  {displayMessages && <DialogMessages messages={post.messages} />}

  <article
    class="post prose mx-auto max-w-(--column)"
  >
    <PostHeader post={post}>
      <dialog
        role="alertdialog"
        open
        class="post-messages not-prose"
      >
        You are looking at version{' '}
        <a
          href={`https://github.com/${options.versioning?.repoOwner}/${options.versioning?.repoName}/commit/${sha}`}
        >
          {sha}
        </a>{
          isLatest ? (
            <>
              , the latest version. Click <a href={postPath(post.slug)}>here</a>{' '}
              to go to the post.
            </>
          ) : (
            <>
              . Click <a href={postPath(post.slug)}>here</a> to go back to the
              latest version.
            </>
          )
        }
      </dialog>
    </PostHeader>
    <div class="post-body">
      <div
        class="post-content"
        set:html={post.content}
      />
      <TableOfContents
        title={post.frontmatter.title}
        entries={post.tableOfContents}
      />
    </div>
  </article>
</Layout>
