---
import Layout from '@/layouts/Layout.astro'
import PostCard from '@/components/PostCard.astro'
import { getPosts, defaultOptions as options } from '@/lib/blogData'

const posts = await getPosts(options)
---

<Layout title="Posts | nrako.com" description="All posts on nrako.com">
  <div class="mx-auto max-w-(--column)">
    {!posts.length && <p class="text-(--muted)">No posts yet.</p>}
    {
      posts.map((post) => (
        <PostCard
          url={`/posts/${post.slug}`}
          frontmatter={post.frontmatter}
          language="en"
          showAuthors={false}
        />
      ))
    }
  </div>
</Layout>
