---
import katexStyles from 'katex/dist/katex.min.css?url'
import Layout from '@/layouts/Layout.astro'
import DialogMessages from '@/components/DialogMessages.astro'
import PostHeader from '@/components/PostHeader.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import BlueSkyInteractions from '@/components/preact/bluesky-interactions'
import { getPost, getPosts, defaultOptions as options } from '@/lib/blogData'

export async function getStaticPaths() {
  const posts = await getPosts(options)
  return posts.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = await getPost(slug, options)

if (!post) {
  return Astro.redirect('/404')
}

const displayMessages = import.meta.env.DEV

// Log messages in development
if (displayMessages) {
  post.messages.errors?.forEach((error) => console.error(post.slug, error))
  post.messages.warnings?.forEach((warning) => console.warn(post.slug, warning))
}
---

<Layout title={`${post.frontmatter.title} - ${options.title}`}>
  {
    /* Served from the site, and only to a post that has math to set */
    post.content.includes('class="katex') && (
      <link rel="stylesheet" href={katexStyles} slot="head" />
    )
  }

  {displayMessages && <DialogMessages messages={post.messages} />}

  <article
    class="post prose mx-auto max-w-(--column)"
  >
    <PostHeader post={post} />
    <div class="post-body">
      <div
        class="post-content"
        set:html={post.content}
      />
      {
        post.frontmatter.site?.bskyUri && (
          <>
            <hr />
            {/* The table of contents links to the reactions by this `id` */}
            <section id="reactions">
              <BlueSkyInteractions
                client:load
                postUri={post.frontmatter.site.bskyUri}
              />
            </section>
          </>
        )
      }
      <TableOfContents
        title={post.frontmatter.title}
        entries={post.tableOfContents}
        reactions={Boolean(post.frontmatter.site?.bskyUri)}
      />
    </div>
  </article>
</Layout>
