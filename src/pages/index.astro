---
import Layout from '@/layouts/Layout.astro'
import Time from '@/components/Time.astro'
import { getPosts, defaultOptions as options } from '@/lib/blogData'

const posts = await getPosts(options)
---

<Layout title="nrako.com" description="nrako's personal website">
  <div class="container max-w-xl mx-auto">
    <header class="pt-8 pb-16">
      <h1 class="text-3xl md:text-4xl font-bold">nrako</h1>
    </header>

    {
      posts.length > 0 && (
        <section>
          <h2 class="text-xl mb-2">Posts</h2>
          <div class="grid divide-y">
            {posts.map((post) => (
              <a class="group" href={`/posts/${post.slug}`}>
                <article class="py-4">
                  <header class="flex gap-x-4 justify-between flex-wrap">
                    <h3 class="font-semibold group-hover:text-red-600">
                      {post.frontmatter.title}
                    </h3>
                    {post.frontmatter.date && (
                      <Time
                        class="flex-auto text-right"
                        date={post.frontmatter.date}
                        language={
                          (post.frontmatter.parts?.language as
                            string | undefined) || 'en'
                        }
                      />
                    )}
                  </header>
                  {post.frontmatter.description && (
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                      {post.frontmatter.description}
                    </p>
                  )}
                </article>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
