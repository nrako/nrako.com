---
import { defaultOptions as options } from '@/lib/blogData'
import type { CommitInfo } from '@/lib/gitVersioning'
import { versionPath } from '@/lib/permalinks'

import Time from './Time.astro'

interface Props {
  slug: string
  versions: CommitInfo[]
}

const { slug, versions } = Astro.props

if (!versions || versions.length === 0) return null

const latestVersion = versions[0]
const lastEditedDate = latestVersion?.date
  ? new Date(latestVersion.date).toLocaleString()
  : 'Unknown'
---

<section class="post-versions not-prose">
  <button
    type="button"
    class="post-versions-button"
    id="versions-button"
    popovertarget="versions-popover"
    title={`Edited on ${lastEditedDate}`}
  >
    {versions.length} edits
  </button>

  <div popover id="versions-popover" class="post-versions-list">
    <h3>Version history</h3>
    <ol>
      {versions.map((version) => <li>
        <p class="post-versions-entry">
          {version.sha === 'draft' ? (
            <strong>Draft</strong>
          ) : (
            <a
              href={versionPath(slug, version.shortSha)}
              title={`View version ${version.shortSha}`}
            >
              {version.shortSha}
            </a>
          )}
          <Time date={version.date} language={options.language} />
          {version.author && <span>by {version.author}</span>}
          {version.verified && <span>verified</span>}
        </p>
        <p class="post-versions-message">{version.message.split('\n')[0]}</p>
      </li>)}
    </ol>
  </div>
</section>
