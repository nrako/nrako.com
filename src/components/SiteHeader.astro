---
import AboutLink from '@/components/AboutLink.astro'
import ThemeToggle from '@/components/preact/theme-toggle'
import ReadingSettings from '@/components/preact/reading-settings'
import TbGitBranch from '@/components/icons/TbGitBranch'
import TbAt from '@/components/icons/TbAt'
---

<header class="site-header container mx-auto pt-8 px-4 md:px-12">
  <div class="site-header-row gap-3 sm:gap-4">
    <nav class="gap-3 sm:gap-4 [&>a:hover]:text-red-600">
      <a href="/" aria-label="Home Base" title="Home Base">
        {
          /* The view box is the outline of the stroke: the shape's edges are the icon's */
        }
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0.7 0.7 22.6 22.6"
          class="home-plate"
          stroke-width="2.6"
          stroke="currentColor"
        >
          <path
            d="M 2,2 L 22,2 L 22,12 L 12,22 L 2,12 Z"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="/posts" aria-label="Blog" title="Posts"> Posts </a>
      {/* The homepage plays its introduction when this anchor is reached */}
      <AboutLink />
      <a
        href="https://bsky.app/profile/nrako.com"
        aria-label="Social"
        title="Follow me and at-me on Bluesky"
        class="ml-auto"
      >
        <TbAt />
      </a>
      <a
        href="https://github.com/nrako"
        title="Collaborate with me on code"
        aria-label="Code"
      >
        <TbGitBranch />
      </a>
    </nav>
    <ReadingSettings client:load />
    <ThemeToggle client:load />
  </div>
</header>
