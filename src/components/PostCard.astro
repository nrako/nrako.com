---
import type { PageFrontmatter } from 'myst-frontmatter'
import Time from './Time.astro'
import Authors from './Authors.astro'

interface Props {
  url: string
  frontmatter: PageFrontmatter
  language?: string
  showAuthors?: boolean
}

const { url, frontmatter, language = 'en', showAuthors = false } = Astro.props
---

<a class="freshBlog-postCard" href={url}>
  <article>
    <header>
      <h2>{frontmatter.title}</h2>
      {
        showAuthors && frontmatter.authors && (
          <Authors
            authors={frontmatter.authors}
            affiliations={frontmatter.affiliations}
          />
        )
      }
      {frontmatter.date && <Time date={frontmatter.date} language={language} />}
    </header>
    <section>
      {frontmatter.description}
    </section>
  </article>
</a>
