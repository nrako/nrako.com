---
import type { PostLinks, SnippetLinks } from '@/lib/permalinks'

// What a page of a post or of a snippet declares about itself, in its head
// (`lib/permalinks.ts`)
interface Props {
  links: PostLinks | SnippetLinks
}

const { links } = Astro.props
---

{links.canonical && <link rel="canonical" href={links.canonical} />}
{links.citeAs && <link rel="cite-as" href={links.citeAs} />}
