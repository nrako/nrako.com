{
  "nodeModulesDir": "auto",
  "unstable": ["sloppy-imports"],
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "tasks": {
    "dev": {
      "description": "Astro dev server (project-scoped FS)",
      "command": "BROWSERSLIST_ROOT_PATH=$PWD deno run --no-prompt --allow-read=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-write=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:astro dev"
    },
    "build": {
      "description": "Production build (project-scoped FS)",
      "command": "BROWSERSLIST_ROOT_PATH=$PWD deno run --no-prompt --allow-read=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-write=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:astro build"
    },
    "check": {
      "description": "Type check via @astrojs/check (Deno-native wrapper)",
      "command": "BROWSERSLIST_ROOT_PATH=$PWD deno run --no-prompt --allow-read=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-write=.,$TMPDIR,$HOME/Library/Caches/deno,$HOME/Library/Preferences/astro --allow-env --allow-net --allow-run --allow-sys --allow-ffi ./scripts/deno-check.mjs"
    },
    "serve": {
      "description": "Pure-Deno preview of dist/server, no FFI/run (genuinely sandboxed)",
      "command": "deno run --no-prompt --allow-read=./dist --allow-net --allow-env ./scripts/deno-serve.mjs"
    },
    "preview": {
      "description": "wrangler dev against the built worker",
      "command": "deno run --no-prompt --allow-read=.,$TMPDIR,$HOME/.wrangler,$HOME/Library/Caches/deno --allow-write=.,$TMPDIR,$HOME/.wrangler,$HOME/Library/Caches/deno --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:wrangler dev --port 4321"
    },
    "deploy": {
      "description": "Build + wrangler deploy",
      "command": "deno task build && deno run --no-prompt --allow-read=.,$TMPDIR,$HOME/.wrangler,$HOME/.config/.wrangler,$HOME/Library/Caches/deno --allow-write=.,$TMPDIR,$HOME/.wrangler,$HOME/.config/.wrangler,$HOME/Library/Caches/deno --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:wrangler deploy"
    },
    "lint": "deno lint",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "test:e2e": {
      "description": "Playwright e2e (uses dev server; full scope for browser launch)",
      "command": "PW_DISABLE_TS_ESM=1 deno run --no-prompt --allow-read --allow-write=.,$TMPDIR --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:@playwright/test test"
    },
    "test:e2e:ui": {
      "command": "PW_DISABLE_TS_ESM=1 deno run --no-prompt --allow-read --allow-write=.,$TMPDIR --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:@playwright/test test --ui"
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "dom.iterable", "deno.ns", "deno.window"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": [
      "src/",
      "scripts/",
      "tests/",
      "posts/",
      "*.ts",
      "*.tsx",
      "*.mjs",
      "*.js",
      "*.json",
      "*.jsonc",
      "*.md",
      "*.astro"
    ],
    "exclude": [
      "dist/",
      ".astro/",
      "node_modules/",
      "playwright-report/",
      "test-results/",
      "package-lock.json"
    ]
  },
  "lint": {
    "include": ["src/", "scripts/", "tests/", "worker.ts", "astro.config.ts"],
    "exclude": [
      "dist/",
      ".astro/",
      "node_modules/",
      "playwright-report/",
      "test-results/"
    ],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "exclude": [
    "dist/",
    ".astro/",
    "node_modules/",
    "playwright-report/",
    "test-results/"
  ]
}
